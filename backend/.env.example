ADDR=:8080

# 前端（nginx）对外端口：仅服务器端 deploy/blogctl 脚本读取，本机开发可忽略
FRONT_PORT=80

# —— 数据库（推荐简单形式：设了 DB_USER 就无需 DSN）——
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=blog
DB_PASSWORD=your-db-password
DB_NAME=personal_blog

# —— 高级用法：需自定义连接参数时改用整行 DSN（设了 DB_USER 则本行被忽略）——
# DSN=blog:password@tcp(127.0.0.1:3306)/personal_blog?collation=utf8mb4_unicode_ci&parseTime=True&loc=Local

JWT_SECRET=change-me-to-a-64-char-random-string
LIKE_SALT=another-random-salt
UPLOAD_DIR=./uploads
APP_ENV=dev
