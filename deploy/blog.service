# 时光集 systemd 单元（spec §10：单二进制 + EnvironmentFile）
#
# 安装：
#   cp deploy/blog.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now blog
#
# 服务端目录约定（与 nginx.conf、deploy.sh 一致）：
#   /var/www/blog/
#     ├── blog-server      # 主程序（deploy.sh 上传）
#     ├── blog-initadmin   # 初始化工具（首次部署手动执行，见 README）
#     ├── dist/            # 前端构建产物
#     ├── uploads/         # 用户上传
#     ├── migrations/      # SQL 迁移（initadmin 幂等应用）
#     └── .env             # 环境变量（含密钥，权限 600，属主 blog）

[Unit]
Description=ShiguangJi blog API (Go)
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=blog
Group=blog
WorkingDirectory=/var/www/blog
EnvironmentFile=/var/www/blog/.env
ExecStart=/var/www/blog/blog-server
Restart=on-failure
RestartSec=3

# 基础加固
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
